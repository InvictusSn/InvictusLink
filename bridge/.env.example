# Bridge token used by the phone app to authenticate.
# Set BRIDGE_TOKEN to a long random string (and keep it on your PC).
BRIDGE_TOKEN="change-me-to-a-long-random-string"

# Cursor API key (used for the built-in Cursor agent provider).
# You can also add providers (OpenAI, Claude, xAI, Ollama, etc.) from the
# phone app: Settings -> AI Providers. Those are stored in
# config/providers.json on this PC and never leave it.
CURSOR_API_KEY="put-your-cursor-api-key-here"

# Must match :3003 in the app Connection URL.
PORT=3003

# Cursor model id (defaults to composer-2.5 in code if missing).
#CURSOR_MODEL_ID="composer-2.5"

# Optional: helps OTA update URLs when phone uses VPN IP.
#PUBLIC_URL="http://100.x.x.x:3003"

# Max minutes one prompt may run before the bridge frees up (default 10).
#TASK_TIMEOUT_MINUTES=10

# Where Link conversation exports from the phone are saved (default: Desktop/GrokResearch).
#EXPORT_DIR=C:\Users\you\Desktop\InvictusLinkExports
